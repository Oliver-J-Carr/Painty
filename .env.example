# Copy to .env and fill in. Never commit .env.
# At least one of these two. OPENAI_API_KEY runs models directly on OpenAI (and uploads
# traces). OPENROUTER_API_KEY runs any model with a "/" in its id (such as
# google/gemma-4-31b-it) through OpenRouter.
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...

# Models offered in the New painting dialog, comma separated. The first is the default.
# They must accept image input if you want to use vision (both defaults do). OpenRouter
# models are easier to add in the app ("Browse OpenRouter models"), with their prices.
PAINTY_MODELS=gpt-6-luna,gpt-6.1-terra,gpt-6.1-sol,gpt-5.4-nano,gpt-5.4-mini,gpt-5.4

# Prices, for the cost estimate on each gallery painting. One variable per model:
# PAINTY_PRICE_ then the model name in capitals with other characters as "_".
# US dollars per million tokens, written input/cached/output/cache write.
# Leave off the cache write price for models that don't bill writes (before GPT-5.6),
# or write input/output if cached input costs the same. Blank means no price; the
# gallery says which to set. Costs always use the current prices, so older paintings
# are priced too.
# OpenAI standard tier, short context (up to 272K input tokens), 6 Nov 2026, with
# the 30-minute cache write rate (Painty's default):
# https://developers.openai.com/api/docs/pricing
PAINTY_PRICE_GPT_6_LUNA=0.10/0.01/0.50/0.125
PAINTY_PRICE_GPT_6_1_TERRA=1.00/0.05/5.00/1.25
PAINTY_PRICE_GPT_6_1_SOL=2.00/0.10/10.00/2.50
PAINTY_PRICE_GPT_5_4_NANO=0.20/0.02/1.25
PAINTY_PRICE_GPT_5_4_MINI=0.75/0.075/4.50
PAINTY_PRICE_GPT_5_4=2.50/0.25/15.00

# Each drawing appears in the OpenAI Traces dashboard under this name.
TRACE_WORKFLOW_NAME=Painty drawing
# Set to true to stop sending traces to OpenAI. OpenRouter runs are traced to OpenAI too,
# images included, whenever OPENAI_API_KEY is set.
OPENAI_AGENTS_DISABLE_TRACING=false

# Where the gallery and saved settings live. Leave blank for the default
# ("data" next to the app; /srv/data inside the container).
DATA_DIR=

# Everything else (budgets, model choice, vision, reasoning effort) is set in
# the on-screen settings panel, not here.
